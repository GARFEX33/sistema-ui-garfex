{
  "name": "garfex-erp-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm router:generate && vite",
    "build": "pnpm router:generate && tsc -b && vite build",
    "test": "vitest run",
    "test:connected": "RUN_CONNECTED_CATALOG_TESTS=true vitest run tests/integration/catalogHierarchyConnectedTransport.test.ts",
    "test:watch": "vitest",
    "test:stories": "vitest --config vitest.storybook.config.ts",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write package.json index.html vite.config.ts tsconfig*.json tsr.config.json vitest*.config.ts playwright.config.ts eslint.config.js prettier.config.mjs .storybook/*.ts src storybook tests scripts/validate-pr-governance.mjs",
    "format:check": "prettier --check package.json index.html vite.config.ts tsconfig*.json tsr.config.json vitest*.config.ts playwright.config.ts eslint.config.js prettier.config.mjs .storybook/*.ts src storybook tests scripts/validate-pr-governance.mjs",
    "typecheck": "pnpm router:generate && tsc -b",
    "router:generate": "tsr generate",
    "router:check": "tsr generate --check",
    "verify:runtime-bundle": "node scripts/verify-runtime-fixtures.mjs"
  },
  "dependencies": {
    "@tanstack/react-router": "1.131.27",
    "convex": "1.45.0",
    "react": "19.1.1",
    "react-aria-components": "1.11.0",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "9.35.0",
    "@playwright/test": "1.55.0",
    "@storybook/addon-a11y": "9.1.5",
    "@storybook/addon-vitest": "9.1.5",
    "@storybook/react-vite": "9.1.5",
    "@tailwindcss/vite": "4.1.13",
    "@tanstack/react-form": "1.19.0",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.13.12",
    "@tanstack/router-cli": "1.131.27",
    "@tanstack/router-plugin": "1.131.27",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.5.2",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "@vitest/browser": "3.2.4",
    "eslint": "9.35.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.16",
    "eslint-plugin-storybook": "9.1.5",
    "jsdom": "26.1.0",
    "playwright": "1.55.0",
    "prettier": "3.6.2",
    "storybook": "9.1.5",
    "tailwindcss": "4.1.13",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.0",
    "vite": "7.1.7",
    "vitest": "3.2.4"
  }
}
